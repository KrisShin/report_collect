# ===== 基础 =====
APP_ENV=development
DEBUG=false
SECRET_KEY=please-generate-a-random-48-char-secret
TIMEZONE=Asia/Shanghai
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 站点 =====
PUBLIC_BASE_URL=https://your-domain.example.com
CLIENT_PATH=/m
ADMIN_PATH=/admin

# ===== 微信服务号 =====
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_OAUTH_REDIRECT_URI=https://your-domain.example.com/api/client/wechat/callback

# ===== 飞书 =====
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_CHAT_ID=

# ===== 腾讯企业邮箱 =====
SMTP_HOST=smtp.exmail.qq.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM_NAME=清华EIRI 报告收集

# ===== 初始管理员（固定账号 + 强密码）=====
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=
